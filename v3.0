<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>保研 AI 面试助手 - Pro</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        apple: {
                            bg: '#fbfbfd',
                            surface: 'rgba(255, 255, 255, 0.75)',
                            border: 'rgba(0, 0, 0, 0.05)',
                            text: '#1d1d1f',
                            subtext: '#86868b',
                            primary: '#fa243c',
                            primaryHover: '#d9182d',
                            blue: '#0071e3',
                            blueHover: '#0077ED'
                        }
                    },
                    boxShadow: {
                        'apple': '0 4px 24px rgba(0, 0, 0, 0.04)',
                        'apple-lg': '0 12px 32px rgba(0, 0, 0, 0.08)',
                    }
                }
            }
        }
    </script>

    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <style>
        /* 苹果风格的毛玻璃效果 */
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    </style>
</head>
<body class="bg-apple-bg text-apple-text antialiased min-h-screen">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useRef } = React;

        const App = () => {
            // 状态管理
            const [user, setUser] = useState(null); // null 表示未注册
            const [credits, setCredits] = useState(5);
            const [promoCode, setPromoCode] = useState('');
            const [uploadedFile, setUploadedFile] = useState(null);
            const [questions, setQuestions] = useState([]);
            const fileInputRef = useRef(null);

            // 注册表单状态
            const [regForm, setRegForm] = useState({ email: '', major: '', target: '' });

            // 1. 处理注册
            const handleRegister = (e) => {
                e.preventDefault();
                if (regForm.email && regForm.major && regForm.target) {
                    setUser(regForm);
                } else {
                    alert("请填写完整的专业与目标院校信息！");
                }
            };

            // 2. 处理文件上传
            const handleFileUpload = (e) => {
                const file = e.target.files[0];
                if (file) {
                    setUploadedFile(file.name);
                }
            };

            // 3. 处理体验码兑换
            const handleRedeem = () => {
                if (promoCode.trim().toUpperCase() === 'NEW2026') {
                    setCredits(prev => prev + 5);
                    setPromoCode('');
                    alert("兑换成功！已为您增加 5 次生成额度。");
                } else {
                    alert("无效的体验码。");
                }
            };

            // 4. 生成题目核心逻辑
            const handleGenerate = (type) => {
                if (credits <= 0) {
                    alert("您的生成次数已用尽！请点击左下角订阅解锁无限次数。");
                    return;
                }

                setCredits(prev => prev - 1);

                const isInterview = type === 'interview';
                
                // 动态构建数据来源标注
                let source = "网站内置题库联合生成";
                if (uploadedFile) {
                    source = `用户私有题库 (${uploadedFile}) & 网站内置题库联合生成`;
                }

                // 动态构建题目内容 (强关联专业)
                const newQuestion = {
                    id: Date.now(),
                    type: isInterview ? '面试训练' : '笔试训练',
                    title: isInterview 
                        ? `针对冲刺【${user.target}】的【${user.major}】专业单面题：`
                        : `【${user.major}】专业核心课高频笔试真题：`,
                    content: isInterview
                        ? `请简述你在本科阶段参与过最深入的一项与${user.major}相关的研究或项目，遇到了什么瓶颈，最后是如何解决的？教授可能会就此进行压力面深挖。`
                        : `请写出${user.major}领域中一个经典理论的推导过程，并结合当前行业前沿技术，论述其在未来 3-5 年的发展趋势。`,
                    source: source,
                    time: new Date().toLocaleTimeString()
                };

                setQuestions([newQuestion, ...questions]);
            };

            // 渲染：未登录状态 (落地页注册拦截)
            if (!user) {
                return (
                    <div className="min-h-screen flex items-center justify-center p-4">
                        <div className="glass-panel shadow-apple-lg rounded-3xl p-10 max-w-md w-full">
                            <div className="text-center mb-8">
                                <h1 className="text-3xl font-bold tracking-tight mb-2">保研 AI 助手</h1>
                                <p className="text-apple-subtext text-sm">告别保研信息差，精准还原面试场景</p>
                            </div>
                            <form onSubmit={handleRegister} className="space-y-5">
                                <div>
                                    <label className="block text-sm font-semibold mb-1">邮箱账号</label>
                                    <input type="email" required className="w-full bg-apple-bg border border-apple-border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-apple-blue transition" placeholder="输入常用邮箱" 
                                        onChange={e => setRegForm({...regForm, email: e.target.value})} />
                                </div>
                                <div>
                                    <label className="block text-sm font-semibold mb-1">本科专业</label>
                                    <input type="text" required className="w-full bg-apple-bg border border-apple-border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-apple-blue transition" placeholder="例如：软件工程、金融学" 
                                        onChange={e => setRegForm({...regForm, major: e.target.value})} />
                                </div>
                                <div>
                                    <label className="block text-sm font-semibold mb-1">目标院校</label>
                                    <input type="text" required className="w-full bg-apple-bg border border-apple-border rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-apple-blue transition" placeholder="例如：清华大学" 
                                        onChange={e => setRegForm({...regForm, target: e.target.value})} />
                                </div>
                                <button type="submit" className="w-full bg-apple-text text-white font-semibold rounded-xl py-3 mt-4 hover:bg-gray-800 transition">
                                    开启保研冲刺
                                </button>
                            </form>
                        </div>
                    </div>
                );
            }

            // 渲染：已登录状态 (主控台)
            return (
                <div className="max-w-4xl mx-auto p-6 pb-24">
                    {/* 顶部个人信息与推荐 */}
                    <div className="glass-panel shadow-apple rounded-3xl p-8 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h2 className="text-2xl font-bold mb-1">你好，冲刺 {user.target} 的同学！</h2>
                            <p className="text-apple-subtext text-sm">今日推荐：已为你筛选 3 道与 <span className="text-apple-blue font-semibold">{user.major}</span> 高度相关的必刷真题。</p>
                        </div>
                        <div className="bg-white rounded-2xl px-5 py-3 shadow-sm border border-apple-border flex flex-col items-center">
                            <span className="text-xs text-apple-subtext font-semibold">剩余生成次数</span>
                            <span className="text-2xl font-bold text-apple-primary">{credits} <span className="text-sm text-gray-400">次</span></span>
                        </div>
                    </div>

                    {/* 交互控制区 */}
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        {/* 左侧：题库与生成 */}
                        <div className="glass-panel shadow-apple rounded-3xl p-6">
                            <h3 className="text-lg font-bold mb-4">🎯 训练生成器</h3>
                            
                            <div className="mb-5">
                                <input type="file" ref={fileInputRef} onChange={handleFileUpload} className="hidden" accept=".pdf,.doc,.docx" />
                                <button onClick={() => fileInputRef.current.click()} className="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-3 px-4 rounded-xl flex justify-center items-center transition">
                                    <svg className="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                    上传本地题库 (PDF/Word)
                                </button>
                                {uploadedFile && <p className="text-xs text-green-600 mt-2 text-center">已加载：{uploadedFile}</p>}
                            </div>

                            <div className="flex gap-3">
                                <button onClick={() => handleGenerate('interview')} className="flex-1 bg-apple-blue hover:bg-apple-blueHover text-white font-semibold py-3 px-4 rounded-xl transition">
                                    面试训练
                                </button>
                                <button onClick={() => handleGenerate('written')} className="flex-1 bg-gray-800 hover:bg-black text-white font-semibold py-3 px-4 rounded-xl transition">
                                    笔试训练
                                </button>
                            </div>
                        </div>

                        {/* 右侧：体验码 */}
                        <div className="glass-panel shadow-apple rounded-3xl p-6 flex flex-col justify-center">
                            <h3 className="text-lg font-bold mb-2">🎁 体验码兑换</h3>
                            <p className="text-sm text-apple-subtext mb-4">推荐新用户或使用活动码，可获取额外生成次数。</p>
                            <div className="flex gap-2">
                                <input type="text" value={promoCode} onChange={(e) => setPromoCode(e.target.value)} placeholder="输入体验码 (如: NEW2026)" className="flex-1 bg-apple-bg border border-apple-border rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-apple-blue transition" />
                                <button onClick={handleRedeem} className="bg-apple-text text-white font-semibold px-5 py-2 rounded-xl">兑换</button>
                            </div>
                        </div>
                    </div>

                    {/* 题目展示区 */}
                    <div className="space-y-4">
                        <h3 className="text-xl font-bold mb-4">📝 你的专属训练记录</h3>
                        {questions.length === 0 ? (
                            <div className="text-center py-10 text-apple-subtext border-2 border-dashed border-gray-200 rounded-3xl">
                                暂无记录，请点击上方按钮生成属于你的专业真题。
                            </div>
                        ) : (
                            questions.map(q => (
                                <div key={q.id} className="bg-white shadow-apple rounded-3xl p-6 border border-apple-border">
                                    <div className="flex justify-between items-center mb-3">
                                        <span className={`text-xs font-bold px-3 py-1 rounded-full ${q.type === '面试训练' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700'}`}>
                                            {q.type}
                                        </span>
                                        <span className="text-xs text-gray-400">{q.time}</span>
                                    </div>
                                    <h4 className="font-bold text-lg mb-2">{q.title}</h4>
                                    <p className="text-gray-700 leading-relaxed mb-4">{q.content}</p>
                                    <div className="bg-gray-50 rounded-lg px-3 py-2 text-xs text-gray-500 inline-block border border-gray-100">
                                        🔍 数据来源：{q.source}
                                    </div>
                                </div>
                            ))
                        )}
                    </div>

                    {/* 左下角固定订阅入口 */}
                    <div className="fixed bottom-6 left-6 w-64 glass-panel shadow-apple-lg border-l-4 border-apple-primary rounded-2xl p-4 z-50">
                        <h4 className="font-bold text-sm mb-1">🚀 升级 Pro 订阅</h4>
                        <p className="text-xs text-apple-subtext mb-3">突破训练次数限制，解锁学长学姐 1v1 辅导与高阶压力面。</p>
                        <button className="w-full bg-apple-primary hover:bg-apple-primaryHover text-white text-sm font-bold py-2 rounded-lg transition" onClick={() => alert('跳转至支付页面...')}>
                            立即订阅
                        </button>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
